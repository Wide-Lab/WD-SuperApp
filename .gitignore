# Configuração local do Claude Code: permissões e preferências de cada máquina.
# As specs em .claude/specs/ são versionadas — elas são o contrato do projeto.
.claude/settings.local.json

# Lixo de sistema operacional.
.DS_Store
Thumbs.db

# Credenciais do docker-compose (raiz) — o par versionado é o .env.example.
/.env

# As dependências e os artefatos de build do frontend ficam em frontend/.gitignore,
# ao lado do que eles ignoram.

# `.env` de produção gerado por scripts/gen-prod-env.sh — contém a chave privada
# da sessão e as senhas do Postgres/MinIO. Nunca vai para o repositório.
/.env.prod

# Imagens de capa usadas manualmente no cadastro; o lugar delas é o bucket, não o git.
/apps/
